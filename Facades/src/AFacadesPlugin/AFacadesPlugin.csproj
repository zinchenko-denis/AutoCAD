<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AFacadesPlugin</AssemblyName>
    <RootNamespace>AFacadesPlugin</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-сборки AutoCAD 2021 (24.0) из NuGet — сборка без AutoCAD,
         в бандл попадает только AFacadesPlugin.dll (паттерн ATableSpec/ABlockGen). -->
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- JavaScriptSerializer (JSON без внешних зависимостей) -->
    <Reference Include="System.Web.Extensions" />
    <!-- Диалог параметров зоны -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Минимальный .xlsx (ZipArchive) — выгрузка ведомости в Excel -->
    <Reference Include="System.IO.Compression" />
    <!-- WPF-сборки НУЖНЫ даже без ленты: у ShowModalDialog и
         Editor.StartUserInteraction есть перегрузки с WPF Window, и для
         разрешения перегрузки компилятору нужен тип Window (CS0012 —
         урок 18.07r, лог Дениса) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
