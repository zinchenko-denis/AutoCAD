<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoCAD.CoreProbe</AssemblyName>
    <RootNamespace>FacadeCoreProbe</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core/Model references only: no AcMgd, UI or COM. Autodesk binaries stay on the host. -->
    <PackageReference Include="AutoCAD.NET.Core" Version="24.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <!-- The same source that is compiled into ACladPlugin, not a replica of its setter. -->
    <Compile Include="../../AClad/src/ACladPlugin/LayoutSafety.cs" Link="Production/LayoutSafety.cs" />
  </ItemGroup>
</Project>
